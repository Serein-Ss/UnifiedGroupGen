# All four settings are required. PROJECT_ROOT must be an existing absolute path.
# Output/log paths may be absolute, relative to PROJECT_ROOT, or use ${PROJECT_ROOT}.
# Missing directories are created by the writer, not while loading settings.
PROJECT_ROOT="/absolute/path/to/UnifiedGroupGen"
HYDRA_JOBS="${PROJECT_ROOT}/outputs"
WANDB_DIR="${PROJECT_ROOT}/wandb"
USE_WANDB_LOGGING=0
